# ────────────────────────────────────────────────────────────────
# Frontend image. Builds the Vite static site, then serves it with
# nginx. nginx also proxies /api → the api container, so the browser
# talks to a single origin and needs no CORS / VITE_API_URL config.
# ────────────────────────────────────────────────────────────────

# ---- Build stage -------------------------------------------------
FROM node:24-slim AS build

RUN npm install -g pnpm@10

WORKDIR /app

# Full workspace manifests so the frozen lockfile validates
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json tsconfig.json ./
COPY lib/api-zod/package.json ./lib/api-zod/
COPY lib/api-client-react/package.json ./lib/api-client-react/
COPY lib/api-spec/package.json ./lib/api-spec/
COPY lib/db/package.json ./lib/db/
COPY artifacts/api-server/package.json ./artifacts/api-server/
COPY artifacts/krishnagiri-lab/package.json ./artifacts/krishnagiri-lab/
COPY artifacts/mockup-sandbox/package.json ./artifacts/mockup-sandbox/
COPY scripts/package.json ./scripts/

# Frontend + its workspace deps (api-client-react, etc.)
RUN pnpm install --frozen-lockfile --filter "@workspace/krishnagiri-lab..."

# Source needed to build the site (lib for api-client-react, plus the app)
COPY lib ./lib
COPY artifacts/krishnagiri-lab ./artifacts/krishnagiri-lab

# Serve from root. VITE_API_URL is intentionally unset so the app uses
# relative /api paths, which nginx forwards to the API container.
ENV BASE_PATH=/
RUN pnpm --filter @workspace/krishnagiri-lab run build

# ---- Runtime stage ----------------------------------------------
FROM nginx:alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/artifacts/krishnagiri-lab/dist/public /usr/share/nginx/html

EXPOSE 80
