# ─────────────────────────────────────────────────────────────
# PathoFix Diagnostics — environment variables
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

# ══ SINGLE-HOST PRODUCTION (docker-compose.prod.yml) ═════════
# Database password (used to build the internal DATABASE_URL).
POSTGRES_PASSWORD=""

# Admin console credentials. Generate BOTH with:
#   node scripts/hash-admin-password.mjs "your-password"
# Only the hash is stored here — never the plaintext password.
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""

# Public domain(s) Caddy should serve + get HTTPS certificates for.
#   "yourdomain.com" or "yourdomain.com, www.yourdomain.com"
#   Use ":80" for local HTTP testing (no certificate).
SITE_DOMAIN="yourdomain.com, www.yourdomain.com"
# Email for the Let's Encrypt account (recommended).
ACME_EMAIL="you@example.com"

# ── Database (set automatically in compose; only needed for a manual /
#    non-Docker run or for `db push` against an external Postgres) ──
DATABASE_URL="postgresql://user:password@host:5432/pathofix?sslmode=require"

# Port the backend listens on. Compose/most hosts inject this.
PORT="5000"

# ── Email alerts via Gmail (optional but recommended) ────────
# Use a Google "App Password", NOT your normal Gmail password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="pathofixdiagnostics@gmail.com"
SMTP_PASS=""
LAB_EMAIL="pathofixdiagnostics@gmail.com"

# ── Telegram alerts (optional) ───────────────────────────────
# Create a bot with @BotFather for the token; get the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates after messaging the bot.
TG_BOT_TOKEN=""
TG_CHAT_ID=""

# ══ MULTI-PROVIDER ALTERNATIVE (Cloudflare Pages + Fly, if used) ══
# Absolute URL of the deployed backend, baked into the PRODUCTION frontend
# build so the static site knows where the API lives. LEAVE UNSET for the
# single-host setup above (frontend and API share an origin behind Caddy).
# Example: https://api.yourdomain.com
VITE_API_URL=""
# Base path the site is served from. Use "/" for a root domain.
BASE_PATH="/"
# If the frontend is on a DIFFERENT origin than the API, list it here so the
# API allows credentialed cross-origin requests (comma-separated). Unset =
# same-origin only (no CORS headers). Wildcard CORS is never used.
CORS_ORIGIN=""

# ── Debug endpoint guard (optional) ──────────────────────────
# If set, /api/test-notifications requires this token via the
# `X-Debug-Token` header in production; otherwise it returns 404.
DEBUG_TOKEN=""

# ── Logging (optional) ───────────────────────────────────────
LOG_LEVEL="info"
