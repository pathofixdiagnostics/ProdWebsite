# Secrets — never ship these into an image
.env
.env.*
!.env.example

# Dependencies & build output (rebuilt inside the image)
node_modules
**/node_modules
**/dist
**/*.tsbuildinfo

# VCS, editor, and Replit/agent state
.git
.gitignore
.local
.agents
.replit
.replitignore

# Docs (not needed at runtime)
*.md
